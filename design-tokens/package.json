{
  "name": "@jablonowski/dsb-tokens",
  "version": "1.0.8",
  "description": "Design System Blueprint — three-tier design tokens (options, decisions, component).",
  "license": "MIT",
  "author": "Mateusz Jablonowski",
  "type": "commonjs",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/ts/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/public.css",
    "./css/full": "./dist/css/variables.css",
    "./scss": "./dist/scss/_public.scss",
    "./scss/full": "./dist/scss/_variables.scss",
    "./json": "./dist/json/decisions.json",
    "./json/full": "./dist/json/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/css",
    "dist/scss",
    "dist/js",
    "dist/ts",
    "dist/json",
    "README.md"
  ],
  "scripts": {
    "build": "style-dictionary build --config config.js",
    "ci": "npm run lint && npm run build && npm test",
    "generate:figma": "node scripts/generate-figma-tokens.js",
    "lint": "npm run lint:json && npm run lint:schema",
    "lint:json": "node scripts/validate-json.js",
    "lint:schema": "node scripts/validate-schema.js",
    "release": "npm run build && npm version patch && npm publish --access public",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jablonowski/design-system-blueprint.git",
    "directory": "design-tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "style-dictionary": "^4.2.0"
  }
}
