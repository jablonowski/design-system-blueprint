{
  "name": "@jablonowski/dsb-components",
  "version": "1.0.0",
  "description": "Design System Blueprint - Angular UI Components",
  "license": "MIT",
  "author": "Mateusz Jablonowski",
  "scripts": {
    "generate:llms:client": "node scripts/generate-llms-client-txt.js",
    "prebuild": "npm run generate:llms:client",
    "build": "ng-packagr -p ng-package.json",
    "release": "npm run build && cd dist && npm version patch && npm publish --access public",
    "lint:raw-values": "node scripts/lint-raw-values.js",
    "lint:raw-values:strict": "DS_LINT_ROLLOUT=strict node scripts/lint-raw-values.js",
    "lint": "npm run lint:raw-values:strict",
    "storybook": "ng run dsbComponents:storybook",
    "build-storybook": "ng run dsbComponents:build-storybook",
    "mcp:contracts": "npm run build-storybook && node scripts/export-storybook-mcp.js",
    "mcp:contracts:fast": "node scripts/export-storybook-mcp.js",
    "test:unit": "jest -c jest.config.unit.js",
    "test:contracts": "node --test test/*.test.js",
    "test:a11y": "test-storybook --ci --url http://localhost:6006",
    "test:interactions": "TEST_A11Y=false test-storybook --ci --url http://localhost:6006",
    "test:visual": "lost-pixel",
    "test:visual:update": "node scripts/guard-visual-update.js && lost-pixel update",
    "test": "npm run test:unit && npm run test:contracts",
    "verify:manifest": "node scripts/verify-published-manifest.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jablonowski/design-system-blueprint.git",
    "directory": "components"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@jablonowski/dsb-tokens": "^1.0.8",
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@jablonowski/dsb-tokens": "file:../design-tokens",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/angular": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.22.0",
    "@types/jest": "^29.5.14",
    "axe-playwright": "^2.0.3",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "lost-pixel": "^3.18.2",
    "ng-packagr": "^19.0.0",
    "storybook": "^8.6.18",
    "typescript": "~5.5.0",
    "wait-on": "^8.0.3",
    "zone.js": "~0.15.0"
  }
}
