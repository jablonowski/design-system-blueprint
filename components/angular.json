{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "dsbComponents": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "dsb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/app",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": ["node_modules/@jablonowski/dsb-tokens/dist/css/variables.css", "src/styles.css"],
            "scripts": []
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "dsbComponents:build",
            "port": 6006,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "dsbComponents:build",
            "outputDir": "storybook-static",
            "compodoc": false
          }
        }
      }
    }
  }
}
